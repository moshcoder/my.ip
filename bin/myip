#!/bin/sh
# myip: this machine's public IPv4 and IPv6, merged into one answer.
#   myip          v4: 2.56.246.141
#                 v6: 2a0e:97c0:3ea:3a7::1
#   myip --json   {"ipv4":"2.56.246.141","ipv6":"2a0e:97c0:3ea:3a7::1"}
#   myip -4 | -6  one bare address
# One request per family (one HTTP request can only ride one), against
# my.ip.pit.world first and ipify as the fallback.
HOST=${MYIP_HOST:-my.ip.pit.world}

lookup() {
  fam=$1; shift
  for url in "$@"; do
    ip=$(curl "-$fam" -fsS --max-time 5 "$url" 2>/dev/null | tr -d '[:space:]')
    case $ip in *[!0-9a-fA-F.:]*|'') continue ;; esac
    echo "$ip"; return
  done
}

# The single-family hosts answer "v4: …\nv6: …"; keep the line for the family asked.
pick() { sed -n "s/^v$1: //p" | grep -v '^none$'; }
v4=$(curl -4 -fsS --max-time 5 "https://4.$HOST/?format=text" 2>/dev/null | pick 4)
[ -n "$v4" ] || v4=$(lookup 4 https://api4.ipify.org https://icanhazip.com)
v6=$(curl -6 -fsS --max-time 5 "https://6.$HOST/?format=text" 2>/dev/null | pick 6)
[ -n "$v6" ] || v6=$(lookup 6 https://api6.ipify.org https://icanhazip.com)

case $1 in
  -j|--json|json)
    q() { if [ -n "$1" ]; then printf '"%s"' "$1"; else printf null; fi; }
    printf '{"ipv4":%s,"ipv6":%s}\n' "$(q "$v4")" "$(q "$v6")" ;;
  -4) echo "${v4:-none}" ;;
  -6) echo "${v6:-none}" ;;
  *) printf 'v4: %s\nv6: %s\n' "${v4:-none}" "${v6:-none}" ;;
esac
